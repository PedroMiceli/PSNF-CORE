GET {{baseUrl}}/ordens-de-pedido/compras
X-Usuario-Id: {{compradorId}}

> {% client.test("200", () => client.assert(response.body.length >= 1)); %}

### 4.5 Minhas vendas (vendedor)
GET {{baseUrl}}/ordens-de-pedido/vendas

> {% client.test("200", () => client.assert(response.body.length >= 1)); %}

### 4.5b [422] Vendedor não cadastra pagamento antes do comprador aceitar
POST {{baseUrl}}/ordens-de-pedido/{{ordemId}}/pagamentos
Content-Type: application/json

{ "tipoPagamento": "PIX", "valor": 10.00, "chavePix": "x" }

> {% client.test("422", () => client.assert(response.status === 422, "status " + response.status)); %}

### 4.5c Comprador confere e aceita a ordem -> ACEITO
PATCH {{baseUrl}}/ordens-de-pedido/{{ordemId}}/aceitar
X-Usuario-Id: {{compradorId}}

> {% client.test("status ACEITO", () => client.assert(response.body.status === "ACEITO", "status " + response.body.status)); %}

### 4.6 Vendedor cadastra a primeira forma de pagamento combinada: PIX (com a chave para receber)
POST {{baseUrl}}/ordens-de-pedido/{{ordemId}}/pagamentos
Content-Type: application/json

{
  "tipoPagamento": "PIX",
  "valor": 550.00,
  "chavePix": "financeiro@vendedor.com",
  "nomeReferencia": "Entrada",
  "dataReferencia": "2026-11-10"
}

> {%
    client.test("continua ACEITO (falta cadastrar 2000)", () => client.assert(response.body.status === "ACEITO" && response.body.valorRestante == 2000));
    client.test("data de referência e chave PIX na resposta", () => client.assert(
        response.body.pagamentos.some(p => p.dataReferencia === "2026-11-10" && p.chavePix === "financeiro@vendedor.com")));
    client.global.set("pagamentoPixId", response.body.pagamentos.find(p => p.tipoPagamento === "PIX").id);
%}

### 4.7 Vendedor cadastra o restante via transferência -> AGUARDANDO_PAGAMENTO
POST {{baseUrl}}/ordens-de-pedido/{{ordemId}}/pagamentos
Content-Type: application/json

{
  "tipoPagamento": "TRANSFERENCIA",
  "valor": 2000.00,
  "codigoBanco": "001",
  "agencia": "0001",
  "conta": "12345-6",
  "nomeReferencia": "Saldo"
}

> {%
    client.test("status AGUARDANDO_PAGAMENTO", () => client.assert(response.body.status === "AGUARDANDO_PAGAMENTO"));
    client.test("nada pago ainda", () => client.assert(response.body.valorPago == 0 && response.body.valorCadastrado == 2550));
    client.global.set("pagamentoTransfId", response.body.pagamentos.find(p => p.tipoPagamento === "TRANSFERENCIA").id);
%}

### 4.7b [403] Só o comprador anexa comprovante
POST {{baseUrl}}/ordens-de-pedido/{{ordemId}}/pagamentos/{{pagamentoPixId}}/comprovante
Content-Type: application/json

{ "caminho": "/arquivos/comprovante-pix.pdf" }

> {% client.test("403", () => client.assert(response.status === 403, "status " + response.status)); %}

### 4.7c Comprador paga o PIX e anexa o comprovante
POST {{baseUrl}}/ordens-de-pedido/{{ordemId}}/pagamentos/{{pagamentoPixId}}/comprovante
Content-Type: application/json
X-Usuario-Id: {{compradorId}}

{ "caminho": "/arquivos/comprovante-pix.pdf" }

> {%
    client.test("continua AGUARDANDO_PAGAMENTO", () => client.assert(response.body.status === "AGUARDANDO_PAGAMENTO"));
    client.test("pago 550", () => client.assert(response.body.valorPago == 550));
%}

### 4.7d [422] Vendedor não exclui pagamento que já tem comprovante
DELETE {{baseUrl}}/ordens-de-pedido/{{ordemId}}/pagamentos/{{pagamentoPixId}}

> {% client.test("422", () => client.assert(response.status === 422, "status " + response.status)); %}

### 4.7e Comprador anexa o comprovante da transferência -> PAGO
POST {{baseUrl}}/ordens-de-pedido/{{ordemId}}/pagamentos/{{pagamentoTransfId}}/comprovante
