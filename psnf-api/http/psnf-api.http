### =============================== 3. ANÚNCIO =========================================

### 3.1 Vendedor cria anúncio (com faixas de preço, imagens e variações)
POST {{baseUrl}}/anuncios
Authorization: Bearer {{tokenVendedor}}
Content-Type: application/json

{
  "titulo": "Carrinho de metal",
  "descricao": "Carrinho de metal para armazém",
  "categoriaId": "{{categoriaId}}",
  "valores": [
    { "valorUnidade": 11.00, "quantidadeMinima": 100 },
    { "valorUnidade": 10.00, "quantidadeMinima": 500 },
    { "valorUnidade": 8.90,  "quantidadeMinima": 1000 }
  ],
  "imagens": [
    { "caminho": "carrinho-1.png", "principal": true },
    { "caminho": "carrinho-2.png" }
  ],
  "variacoes": [
    { "variacao": "BRANCO - P", "sku": "CAR-MET-BP", "gtin": "7891234567895" },
    { "variacao": "BRANCO - M" },
    { "variacao": "AZUL - P" }
  ],
  "informacoes": {
    "sku": "CAR-MET",
    "gtin": "7891000315507",
    "marca": "Metalúrgica Exemplo",
    "condicao": "NOVO",
    "ncm": "87168000",
    "origem": 0,
    "unidadeComercial": "un",
    "pesoLiquidoKg": 12.5,
    "pesoBrutoKg": 14.0,
    "comprimentoCm": 90, "larguraCm": 60, "alturaCm": 100,
    "garantiaMeses": 12,
    "garantiaResponsavel": "FABRICANTE"
  },
  "caracteristicas": [
    { "nome": "Material", "valor": "Aço carbono com pintura epóxi" },
    { "nome": "Capacidade", "valor": "200 kg" }
  ]
}

> {%
    client.test("201 - anúncio criado", () => client.assert(response.status === 201, "status " + response.status));
    client.test("NCM formatado", () => client.assert(response.body.informacoes.ncm === "8716.80.00"));
    client.test("unidade em maiúsculas", () => client.assert(response.body.informacoes.unidadeComercial === "UN"));
    client.test("ficha técnica", () => client.assert(response.body.caracteristicas.length === 2));
    client.test("SKU da variação", () => client.assert(response.body.variacoes[0].sku === "CAR-MET-BP"));
    client.global.set("anuncioId", response.body.id);
    client.global.set("variacaoId", response.body.variacoes[0].id);
%}

