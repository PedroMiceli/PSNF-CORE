Content-Type: application/json

{ "token": "{{tokenRedefinicao}}", "novaSenha": "outra-senha-456" }

> {% client.test("422", () => client.assert(response.status === 422, "status " + response.status)); %}

### 9.6 [401] A senha antiga não entra mais
POST {{baseUrl}}/auth/token
Content-Type: application/json

{ "email": "{{novoUsuarioEmail}}", "senha": "teste123" }

> {% client.test("401", () => client.assert(response.status === 401, "status " + response.status)); %}

### 9.7 A senha nova entra
POST {{baseUrl}}/auth/token
Content-Type: application/json

{ "email": "{{novoUsuarioEmail}}", "senha": "senha-nova-123" }

> {% client.test("200", () => client.assert(response.status === 200 && !!response.body.accessToken, "status " + response.status)); %}


