### =====================================================================================
### PSNF API — roteiro de testes (IntelliJ HTTP Client)
###
### Como usar:
###  1. Suba a API (Postgres rodando). Os usuários de teste são criados automaticamente
###     (senha 123456): vendedor@mock.psnf ({{vendedorId}}) e comprador@mock.psnf ({{compradorId}}).
###     A seção 0 faz login com cada um (POST /auth/token) e guarda os tokens; as requisições
###     seguintes usam "Authorization: Bearer {{tokenVendedor}}" ou {{tokenComprador}}.
###     (O navegador usa cookies HttpOnly + CSRF; aqui, como em qualquer script, vai o header.)
###  2. Execute as requisições DE CIMA PARA BAIXO (ou "Run All Requests in File").
###     Cada resposta guarda os ids necessários nas variáveis seguintes.
###  As variáveis abaixo já bastam; não é preciso selecionar ambiente.
###  (Se a API rodar em outra porta, altere o @baseUrl.)
### =====================================================================================

@baseUrl = http://localhost:8080
@vendedorId = 3c288400-f58f-4d28-905c-f7dba388d6c9
@compradorId = 7f1e2a5b-9c3d-4e8f-a6b7-1d2c3e4f5a6b
@terceiroId = 00000000-0000-0000-0000-000000000001


### =============================== 0. AUTENTICAÇÃO ====================================

### 0.1 [401] Sem login nada responde (só /auth/** e o cadastro são públicos)
GET {{baseUrl}}/usuarios/me

> {% client.test("401", () => client.assert(response.status === 401, "status " + response.status)); %}

### 0.2 [401] Senha errada (mesma mensagem para e-mail inexistente: não revela quem tem conta)
POST {{baseUrl}}/auth/token
Content-Type: application/json

{ "email": "vendedor@mock.psnf", "senha": "errada" }

> {% client.test("401", () => client.assert(response.status === 401 && response.body.erro === "E-mail ou senha inválidos", "status " + response.status)); %}

### 0.3 Login do vendedor (tokens no corpo, para scripts; o navegador usa POST /auth/login com cookies)
POST {{baseUrl}}/auth/token
Content-Type: application/json

{ "email": "vendedor@mock.psnf", "senha": "123456" }

> {%
    client.test("200 - tokens emitidos", () => client.assert(response.status === 200 && !!response.body.accessToken && !!response.body.refreshToken));
    client.test("é o vendedor mock", () => client.assert(response.body.usuario.id === "3c288400-f58f-4d28-905c-f7dba388d6c9"));
    client.global.set("tokenVendedor", response.body.accessToken);
    client.global.set("refreshVendedor", response.body.refreshToken);
%}

### 0.4 Login do comprador
POST {{baseUrl}}/auth/token
Content-Type: application/json

{ "email": "comprador@mock.psnf", "senha": "123456" }

> {%
    client.test("200", () => client.assert(response.status === 200));
    client.global.set("tokenComprador", response.body.accessToken);
%}

### 0.5 [401] Token adulterado
GET {{baseUrl}}/usuarios/me
Authorization: Bearer {{tokenVendedor}}x

> {% client.test("401", () => client.assert(response.status === 401, "status " + response.status)); %}

### 0.6 Renovar a sessão: o refresh token é trocado por outro (rotação)
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{ "refreshToken": "{{refreshVendedor}}" }

> {%
    client.test("200 - par novo", () => client.assert(response.status === 200 && response.body.refreshToken !== client.global.get("refreshVendedor")));
    client.global.set("refreshVendedor2", response.body.refreshToken);
%}

### 0.7 Logout encerra a sessão (o refresh deixa de valer)
POST {{baseUrl}}/auth/logout
Content-Type: application/json

{ "refreshToken": "{{refreshVendedor2}}" }

> {% client.test("204", () => client.assert(response.status === 204, "status " + response.status)); %}

### 0.8 [401] Refresh depois do logout
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{ "refreshToken": "{{refreshVendedor2}}" }

> {% client.test("401", () => client.assert(response.status === 401, "status " + response.status)); %}


### =============================== 1. CATEGORIA =======================================

### 1.1 Listar categorias (fixas, carregadas pela API) e usar "Utilidades Domésticas" nos testes
GET {{baseUrl}}/categorias
Authorization: Bearer {{tokenVendedor}}

> {%
    client.test("200 - 34 categorias fixas", () => client.assert(response.status === 200 && response.body.length >= 34));
    const categoria = response.body.find(c => c.nome === "Utilidades Domésticas");
    client.test("categoria 'Utilidades Domésticas' existe", () => client.assert(!!categoria));
    client.global.set("categoriaId", categoria.id);
%}

### 1.2 [405] Usuários não criam categorias (a API só oferece leitura)
POST {{baseUrl}}/categorias
Authorization: Bearer {{tokenVendedor}}
Content-Type: application/json

{
  "nome": "Categoria criada por usuário"
}

> {% client.test("405 - criação de categoria não existe", () => client.assert(response.status === 405, "status " + response.status)); %}


### =============================== 2. USUÁRIO =========================================

### 2.1 Usuário logado (o dono do token: vendedor mock)
GET {{baseUrl}}/usuarios/me
Authorization: Bearer {{tokenVendedor}}

> {% client.test("200 - é o vendedor mock", () => client.assert(response.body.id === "3c288400-f58f-4d28-905c-f7dba388d6c9")); %}

### 2.2 Buscar o comprador mock por id
GET {{baseUrl}}/usuarios/{{compradorId}}
Authorization: Bearer {{tokenVendedor}}

> {% client.test("200 - comprador mock", () => client.assert(response.status === 200)); %}

### 2.3 Cadastrar um novo usuário
POST {{baseUrl}}/usuarios
Content-Type: application/json

{
  "email": "teste-{{$random.alphanumeric(8)}}@psnf.com",
  "senha": "teste123",
  "nome": "Usuário de Teste",
  "telefone": "11987654321",
  "enderecos": [
    {
      "logradouro": "Rua Doutor Alfredo de Castro",
      "numero": "200",
      "complemento": "Sala 806",
      "bairro": "Barra Funda",
      "cidade": "São Paulo",
      "cep": "01155-060",
      "uf": "SP"
    }
  ]
}

> {%
    client.test("201 - usuário criado", () => client.assert(response.status === 201, "status " + response.status));
    client.global.set("novoUsuarioId", response.body.id);
    client.global.set("novoUsuarioEmail", response.body.email);
%}

### 2.3a [403] Conta nova só entra depois de confirmar o e-mail
POST {{baseUrl}}/auth/token
Content-Type: application/json

{ "email": "{{novoUsuarioEmail}}", "senha": "teste123" }

> {% client.test("403 EMAIL_NAO_CONFIRMADO", () => client.assert(response.status === 403 && response.body.codigo === "EMAIL_NAO_CONFIRMADO", "status " + response.status)); %}

### 2.3b E-mail de confirmação (sem SMTP, a API guarda os e-mails em GET /dev/emails)
GET {{baseUrl}}/dev/emails?para={{novoUsuarioEmail}}
Authorization: Bearer {{tokenVendedor}}

> {%
    client.test("e-mail de confirmação enviado", () => client.assert(response.status === 200 && response.body.length >= 1 && response.body[0].assunto === "Confirme seu e-mail no PSNF"));
    client.global.set("tokenConfirmacao", /token=([\w-]+)/.exec(response.body[0].texto)[1]);
%}

### 2.3c Confirmar o e-mail com o link
POST {{baseUrl}}/auth/confirmar-email
Content-Type: application/json

{ "token": "{{tokenConfirmacao}}" }

> {% client.test("204", () => client.assert(response.status === 204, "status " + response.status)); %}

### 2.3d [422] O link é de uso único
POST {{baseUrl}}/auth/confirmar-email
Content-Type: application/json

{ "token": "{{tokenConfirmacao}}" }

> {% client.test("422", () => client.assert(response.status === 422, "status " + response.status)); %}

### 2.3e Esqueci a senha: 204 sempre (não revela se o e-mail existe)
POST {{baseUrl}}/auth/esqueci-senha
Content-Type: application/json

{ "email": "ninguem-{{$random.alphanumeric(6)}}@psnf.com" }

> {% client.test("204", () => client.assert(response.status === 204, "status " + response.status)); %}

### 2.3f Login do novo usuário (nas seções seguintes ele faz o papel de "terceiro", que não participa)
POST {{baseUrl}}/auth/token
Content-Type: application/json

{ "email": "{{novoUsuarioEmail}}", "senha": "teste123" }

> {%
    client.test("200", () => client.assert(response.status === 200));
    client.global.set("tokenNovoUsuario", response.body.accessToken);
%}

### 2.4 Atualizar dados do usuário logado (como o novo usuário)
