### 12.1 Um anúncio ativo do vendedor
GET {{baseUrl}}/anuncios/meus
Authorization: Bearer {{tokenVendedor}}

> {% client.global.set("anuncioAtivoId", response.body.find(a => a.ativo).id); %}

### 12.2 Ordem nova: 10 x R$ 12,50 (aguardando confirmação do comprador)
POST {{baseUrl}}/ordens-de-pedido
Authorization: Bearer {{tokenVendedor}}
Content-Type: application/json

{
  "compradorId": "{{compradorId}}",
  "itens": [ { "anuncioId": "{{anuncioAtivoId}}", "quantidade": 10, "valorUnidade": 12.50 } ]
}

> {%
    client.test("201", () => client.assert(response.status === 201 && response.body.valorTotal === 125));
    client.global.set("ordemRenegId", response.body.id);
    client.global.set("itemRenegId", response.body.itens[0].id);
%}

### 12.3 [403] O comprador não altera valores
PUT {{baseUrl}}/ordens-de-pedido/{{ordemRenegId}}/itens/valores
Authorization: Bearer {{tokenComprador}}
Content-Type: application/json

{ "itens": [ { "itemId": "{{itemRenegId}}", "valorUnidade": 1.00 } ] }

> {% client.test("403", () => client.assert(response.status === 403, "status " + response.status)); %}

### 12.4 [400] Valor zero
PUT {{baseUrl}}/ordens-de-pedido/{{ordemRenegId}}/itens/valores
Authorization: Bearer {{tokenVendedor}}
Content-Type: application/json

{ "itens": [ { "itemId": "{{itemRenegId}}", "valorUnidade": 0 } ] }

> {% client.test("400", () => client.assert(response.status === 400, "status " + response.status)); %}

### 12.5 O vendedor renegocia: R$ 9,90 por unidade; o comprador recebe a mensagem com o antes e o depois
PUT {{baseUrl}}/ordens-de-pedido/{{ordemRenegId}}/itens/valores
Authorization: Bearer {{tokenVendedor}}
Content-Type: application/json

{ "itens": [ { "itemId": "{{itemRenegId}}", "valorUnidade": 9.90 } ] }

> {%
    client.test("200 e total novo", () => client.assert(response.status === 200 && response.body.valorTotal === 99, "total " + response.body.valorTotal));
    const ultima = response.body.mensagensIncidente[response.body.mensagensIncidente.length - 1];
    client.test("mensagem automática", () => client.assert(ultima.mensagem.startsWith("Valores renegociados pelo vendedor:") && ultima.mensagem.includes("Novo total")));
%}

### 12.6 O comprador aceita o valor novo
PATCH {{baseUrl}}/ordens-de-pedido/{{ordemRenegId}}/aceitar
Authorization: Bearer {{tokenComprador}}

> {% client.test("ACEITO", () => client.assert(response.status === 200 && response.body.status === "ACEITO")); %}

### 12.7 [422] Depois do aceite, os valores ficam como combinados
PUT {{baseUrl}}/ordens-de-pedido/{{ordemRenegId}}/itens/valores
Authorization: Bearer {{tokenVendedor}}
Content-Type: application/json

{ "itens": [ { "itemId": "{{itemRenegId}}", "valorUnidade": 5.00 } ] }

> {% client.test("422", () => client.assert(response.status === 422, "status " + response.status)); %}


### =============================== 13. RETIRADA NO LOCAL ==============================
### (usa a ordem renegociada da seção 12, que já foi aceita)

### 13.1 O vendedor indica retirada no local: o código de rastreio é descartado (não há envio)
PUT {{baseUrl}}/ordens-de-pedido/{{ordemRenegId}}/entrega
Authorization: Bearer {{tokenVendedor}}
Content-Type: application/json

{ "descricao": "Rua das Flores, 10 - seg a sex, 8h às 17h", "codigoRastreio": "BR123", "retiradaNoLocal": true }

> {%
    client.test("200 e retirada sem rastreio", () => client.assert(response.status === 200
        && response.body.entrega.retiradaNoLocal === true && response.body.entrega.codigoRastreio === null));
    const ultima = response.body.mensagensIncidente[response.body.mensagensIncidente.length - 1];
    client.test("o comprador é avisado", () => client.assert(ultima.mensagem.includes("RETIRADO NO LOCAL")));
%}

### 13.2 [403] O comprador não define a forma de entrega
PUT {{baseUrl}}/ordens-de-pedido/{{ordemRenegId}}/entrega
Authorization: Bearer {{tokenComprador}}
Content-Type: application/json

{ "retiradaNoLocal": false }

> {% client.test("403", () => client.assert(response.status === 403, "status " + response.status)); %}

### 13.3 Combinaram outra coisa: o vendedor desfaz a retirada e informa o envio
PUT {{baseUrl}}/ordens-de-pedido/{{ordemRenegId}}/entrega
Authorization: Bearer {{tokenVendedor}}
Content-Type: application/json

{ "descricao": "Transportadora X", "codigoRastreio": "BR999", "retiradaNoLocal": false }

> {%
    client.test("200 e envio com rastreio", () => client.assert(response.status === 200
        && response.body.entrega.retiradaNoLocal === false && response.body.entrega.codigoRastreio === "BR999"));
    const ultima = response.body.mensagensIncidente[response.body.mensagensIncidente.length - 1];
    client.test("o comprador é avisado da mudança", () => client.assert(ultima.mensagem.includes("NÃO será mais retirado no local")));
%}


